# Copy to .env and fill in real values. Never commit .env.

# --- API (Phase 5) ---
ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# SQLite store used until Phase 2 lands. Delete the line to use challenge_map.db.
# CHALLENGEMAP_DB_PATH=./challenge_map.db

# --- Database (Phase 2): PostgreSQL + pgvector ---
# Not wired yet: the API persists to SQLite until a Postgres instance exists.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/challengemap

# --- Rate limiting (Phase 5) ---
# Set to false to disable the slowapi limits on /auth/* and /complaints.
RATE_LIMIT_ENABLED=true

# --- Auth (Phase 5) ---
# Use a long random value (32+ bytes recommended for HS256; longer is safer).
JWT_SECRET=QX9l4N6@p7vM2x!r8wT1uGz4sK6bD9mC3qR7wV2nH5yL8cF0kP1dJ4mQ6rT8uW0
JWT_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
# Created (or promoted to admin) on startup: username:password
CHALLENGEMAP_BOOTSTRAP_ADMIN=admin:ChangeThisPassword!2026
# Required email address for the bootstrap administrator.
CHALLENGEMAP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- ML (Phase 4) ---
# Reserved for the optional SBERT path; the installed TF-IDF pipeline does not read these.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
DEDUP_THRESHOLD=0.86

# --- Frontend ---
# Base URL of the FastAPI service. The browser and server components both use it.
NEXT_PUBLIC_API_BASE=http://localhost:8000
